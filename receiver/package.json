{
  "name": "screen-mirror-receiver",
  "productName": "화면 미러링 수신기",
  "version": "0.1.0",
  "description": "교실 PC용 Android 화면 미러링 수신 프로그램",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/server.test.js",
    "test:sender": "electron test/fake-sender.js",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0"
  },
  "devDependencies": {
    "electron": "44.10.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "app.screenmirror.receiver",
    "productName": "ScreenMirrorReceiver",
    "executableName": "ScreenMirrorReceiver",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "shortcutName": "화면 미러링 수신기"
    }
  }
}
